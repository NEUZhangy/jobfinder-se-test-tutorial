{
  "name": "jobfinder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types",
    "check": "tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply jobfinder --local",
    "db:migrate:remote": "wrangler d1 migrations apply jobfinder --remote",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "playwright test && nyc report && nyc check-coverage"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "nyc": "^18.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.1.1",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  }
}
